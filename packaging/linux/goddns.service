[Unit]
Description=GoDDNS dynamic DNS updater
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=goddns
Group=goddns
ExecStart=/usr/local/bin/goddns run --config /etc/goddns/config.json
Restart=on-failure
RestartSec=10s

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/goddns

# GoDDNS writes structured logs to stderr/stdout. systemd-journald collects them.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
