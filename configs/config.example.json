{
  "general": {
    "interval": "10m",
    "log_level": "info"
  },
  "dns": {
    "provider": "simply",
    "mode": "dyndns2",
    "domain": "lumiar.info",
    "host": "home",
    "product": "lumiar.info",
    "record_id": 0,
    "ttl": 3600,
    "credentials": {
      "account": "test",
      "api_key": "test_api_key"
    }
  },
  "discovery": {
    "ipv4": true,
    "ipv6": false,
    "sources": [
      "https://api.ipify.org",
      "https://icanhazip.com",
      "https://ifconfig.me/ip"
    ],
    "min_consensus": 2
  },
  "state": {
    "path": "/var/db/goddns/state.json"
  }
}
