{
  "general": {
    "interval": "10m",
    "log_level": "info",
    "log_file": ""
  },
  "dns": {
    "provider": "simply",
    "mode": "dyndns2",
    "domain": "lumiar.info",
    "host": "home",
    "product": "lumiar.info",
    "record_id": 0,
    "ttl": 3600,
    "credentials": {
      "account": "test",
      "api_key": "test_api_key"
    }
  },
  "discovery": {
    "ipv4": true,
    "ipv6": false,
    "sources": [
      "https://api.ipify.org",
      "https://icanhazip.com",
      "https://ifconfig.me/ip",
      "https://checkip.amazonaws.com",
      "https://ipinfo.io/ip",
      "https://ident.me",
      "https://api.seeip.org/",
      "https://api-ipv4.ip.sb/ip",
      "https://checkip.dyndns.com/",
      "https://ipcomet.com/api/me",
      "https://www.my-ip-is.com/api/ipv4",
      "https://public-apps.com/what-is-my-ip/txt/",
      "https://wtfismyip.com/text"
    ],

    "min_consensus": 3
  },
  "state": {
    "path": "/var/db/goddns/state.json"
  }
}
